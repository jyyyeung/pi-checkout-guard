{
  "name": "pi-checkout-guard",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Ambient session presence + peer-aware safety guard for shared git checkouts: blocks destructive git ops while other agent sessions are live, and stops edits escaping isolated worktrees.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "git",
    "worktree",
    "multi-agent",
    "safety",
    "shared-checkout",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jyyyeung/pi-checkout-guard.git"
  },
  "pi": {
    "extensions": ["./extensions/checkout-guard.ts"],
    "skills": ["./skills/checkout-guard"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  }
}

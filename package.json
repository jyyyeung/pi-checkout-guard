{
  "name": "pi-checkout-guard",
  "version": "0.1.4",
  "description": "Ambient session presence + peer-aware safety guard for shared git checkouts: blocks destructive git ops while other agent sessions are live, and stops edits escaping isolated worktrees.",
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions/",
    "src/",
    "skills/",
    "hooks/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "git",
    "worktree",
    "multi-agent",
    "safety",
    "shared-checkout",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyyyeung/pi-checkout-guard.git"
  },
  "homepage": "https://github.com/jyyyeung/pi-checkout-guard#readme",
  "bugs": {
    "url": "https://github.com/jyyyeung/pi-checkout-guard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "jiti": "^2.7.0",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./extensions/checkout-guard.ts"
    ],
    "skills": [
      "./skills/checkout-guard"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  }
}
